"""Type stubs for mlx_lm.models.laguna"""

from dataclasses import dataclass
from typing import Any, Callable, Dict, List, Optional

import mlx.core as mx
import mlx.nn as nn

from .base import BaseModelArgs
from .cache import KVCache, RotatingKVCache
from .switch_layers import SwitchGLU

@dataclass
class ModelArgs(BaseModelArgs):
    model_type: str = ...
    vocab_size: int = ...
    hidden_size: int = ...
    intermediate_size: int = ...
    num_hidden_layers: int = ...
    num_attention_heads: int = ...
    num_key_value_heads: int = ...
    head_dim: int = ...
    max_position_embeddings: int = ...
    rms_norm_eps: float = ...
    attention_bias: bool = ...
    qkv_bias: bool = ...
    gating: bool | str = ...
    tie_word_embeddings: bool = ...
    sliding_window: Optional[int] = ...
    partial_rotary_factor: Optional[float] = ...
    rope_parameters: Optional[Dict[str, Any]] = ...
    layer_types: Optional[List[str]] = ...
    num_attention_heads_per_layer: Optional[List[int]] = ...
    mlp_layer_types: Optional[List[str]] = ...
    num_experts: int = ...
    num_experts_per_tok: int = ...
    moe_intermediate_size: int = ...
    shared_expert_intermediate_size: int = ...
    moe_routed_scaling_factor: float = ...
    moe_router_logit_softcapping: float = ...
    moe_router_score_func: str = ...

class Attention(nn.Module):
    n_heads: int
    n_kv_heads: int
    head_dim: int
    gating: bool | str
    use_sliding: bool
    scale: float
    q_proj: nn.Linear
    k_proj: nn.Linear
    v_proj: nn.Linear
    o_proj: nn.Linear
    g_proj: nn.Linear
    q_norm: nn.RMSNorm
    k_norm: nn.RMSNorm
    rope: nn.Module

    def __init__(self, args: ModelArgs, layer_idx: int) -> None: ...
    def __call__(
        self,
        x: mx.array,
        mask: Optional[mx.array] = None,
        cache: Optional[Any] = None,
    ) -> mx.array: ...

class MLP(nn.Module):
    gate_proj: nn.Linear
    down_proj: nn.Linear
    up_proj: nn.Linear

    def __init__(self, dim: int, hidden_dim: int) -> None: ...
    def __call__(self, x: mx.array) -> mx.array: ...

class MoEGate(nn.Module):
    top_k: int
    num_experts: int
    softcap: float
    score_func: str
    proj: nn.Linear
    e_score_correction_bias: mx.array

    def __init__(self, args: ModelArgs) -> None: ...
    def __call__(self, x: mx.array) -> tuple[mx.array, mx.array]: ...

class MoE(nn.Module):
    routed_scaling_factor: float
    gate: MoEGate
    switch_mlp: SwitchGLU
    shared_expert: MLP

    def __init__(self, args: ModelArgs) -> None: ...
    def __call__(self, x: mx.array) -> mx.array: ...

class TransformerBlock(nn.Module):
    self_attn: Attention
    use_sliding: bool
    mlp: MLP | MoE
    input_layernorm: nn.RMSNorm
    post_attention_layernorm: nn.RMSNorm

    def __init__(self, args: ModelArgs, layer_idx: int) -> None: ...
    def __call__(
        self,
        x: mx.array,
        mask: Optional[mx.array] = None,
        cache: Optional[Any] = None,
    ) -> mx.array: ...

class LagunaModel(nn.Module):
    args: ModelArgs
    vocab_size: int
    sliding_window: Optional[int]
    layer_types: List[str]
    embed_tokens: nn.Embedding
    layers: List[TransformerBlock]
    norm: nn.RMSNorm
    fa_idx: int
    swa_idx: Optional[int]

    def __init__(self, args: ModelArgs) -> None: ...
    def __call__(
        self,
        inputs: mx.array,
        cache: Optional[Any] = None,
        input_embeddings: Optional[mx.array] = None,
    ) -> mx.array: ...

class Model(nn.Module):
    args: ModelArgs
    model_type: str
    model: LagunaModel
    lm_head: nn.Linear

    def __init__(self, args: ModelArgs) -> None: ...
    def __call__(
        self,
        inputs: mx.array,
        cache: Optional[Any] = None,
        input_embeddings: Optional[mx.array] = None,
    ) -> mx.array: ...
    @property
    def layers(self) -> List[TransformerBlock]: ...
    @property
    def quant_predicate(self) -> Callable[[str, Any], Any]: ...
    @property
    def cast_predicate(self) -> Callable[[str], bool]: ...
    def make_cache(self) -> List[KVCache | RotatingKVCache]: ...
    def sanitize(self, weights: Dict[str, mx.array]) -> Dict[str, mx.array]: ...
