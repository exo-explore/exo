class DenseMLP(nn.Module):
    gate_proj: nn.Linear
    up_proj: nn.Linear
    down_proj: nn.Linear

    def __init__(
        self, hidden: int, inter: int, *, activation: Callable[..., mx.array]
    ) -> None: ...
    def __call__(self, x: mx.array) -> mx.array: ...

class SparseMoeBlock(nn.Module):
    num_experts_per_tok: int
    routed_scaling_factor: float
    gate: nn.Linear
    e_score_correction_bias: mx.array
    switch_mlp: SwitchGLU
    shared_experts: DenseMLP
    sharding_group: Optional[mx.distributed.Group]

    def __init__(self, args: TextArgs) -> None: ...
    def __call__(self, x: mx.array) -> mx.array: ...

class Attention(nn.Module):
    hidden_dim: int
    num_attention_heads: int
    num_key_value_heads: int
    head_dim: int
    scale: float
    q_proj: nn.Linear
    k_proj: nn.Linear
    v_proj: nn.Linear
    o_proj: nn.Linear
    use_qk_norm: bool
